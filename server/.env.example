# Server Configuration
PORT=3001
NODE_ENV=development

# Database Connection (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/petreunite

# CORS
CORS_ORIGIN=http://localhost:5173

# Auto-run migrations on startup (set to false in production)
AUTO_MIGRATE=true

# Frontend URL (for OAuth redirects)
FRONTEND_URL=http://localhost:5173

# Yandex OAuth
# Get credentials at https://oauth.yandex.ru/
YANDEX_CLIENT_ID=your_yandex_client_id
YANDEX_CLIENT_SECRET=your_yandex_client_secret
YANDEX_REDIRECT_URI=http://localhost:3001/api/auth/yandex/callback

# JWT Secret (generate a secure random string for production)
JWT_SECRET=your_jwt_secret_change_in_production

# Digital Ocean Spaces (S3-compatible storage for images)
# Get credentials at https://cloud.digitalocean.com/spaces
DO_SPACES_KEY=your_spaces_access_key
DO_SPACES_SECRET=your_spaces_secret_key
DO_SPACES_BUCKET=petreunite
DO_SPACES_REGION=fra1
DO_SPACES_ENDPOINT=https://fra1.digitaloceanspaces.com
DO_SPACES_CDN_URL=https://petreunite.fra1.cdn.digitaloceanspaces.com
