# ДомойСкорей deploy config. Copy to .env and fill in. NEVER commit the real .env.
#   cp .env.example .env && nano .env
# Generate secrets with: openssl rand -hex 32

# ---- Public host ----
# A record (and cdn.<domain>) must point at 5.42.108.44 before bringing the
# stack up, or Caddy cannot obtain a TLS certificate.
DOMAIN=example.com
ACME_EMAIL=you@example.com

# ---- Postgres (internal only) ----
POSTGRES_USER=petreunite
POSTGRES_PASSWORD=CHANGE_ME_db_password
POSTGRES_DB=petreunite

# ---- MinIO object storage (internal; objects served via cdn.<domain>) ----
MINIO_ROOT_USER=petreunite
MINIO_ROOT_PASSWORD=CHANGE_ME_minio_password_min_8_chars
DO_SPACES_BUCKET=petreunite

# ---- App secrets ----
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
ADMIN_API_KEY=CHANGE_ME_openssl_rand_hex_32

# ---- Yandex OAuth (https://oauth.yandex.ru/) ----
# In the Yandex app, the Redirect URI MUST be exactly:
#   https://<DOMAIN>/api/auth/yandex/callback
YANDEX_CLIENT_ID=your_yandex_client_id
YANDEX_CLIENT_SECRET=your_yandex_client_secret

# ---- Yandex Maps (https://developer.tech.yandex.ru/) ----
# Baked into the frontend bundle at build time. Restrict by HTTP referrer to
# https://<DOMAIN>/* in the Yandex console.
VITE_YANDEX_MAPS_API_KEY=your_yandex_maps_api_key

# ---- Gatus status dashboard ----
# Basic-auth creds for https://status.<DOMAIN> live in a SEPARATE file: status.env
# (the bcrypt hash's $ signs would break compose's interpolation of THIS file).
# See deploy/status.env.example.
