# Basic-auth credentials for the Gatus status dashboard (https://status.<DOMAIN>).
# Copy to status.env (gitignored). Kept separate from .env because the bcrypt hash
# contains $ characters that would break docker compose's ${...} interpolation.
#
# Generate the hash:
#   docker run --rm caddy:2-alpine caddy hash-password --plaintext 'YOUR_PASSWORD'
#
# Paste the FULL output (it starts with $2a$...) as STATUS_HASH.
STATUS_USER=admin
STATUS_HASH=$2a$14$replace_with_real_bcrypt_hash
