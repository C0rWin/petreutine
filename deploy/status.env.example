# Basic-auth credentials for the Gatus status dashboard (https://status.<DOMAIN>).
# Copy to status.env (gitignored). Kept separate from .env, but note: docker compose
# STILL interpolates env_file contents, so you must DOUBLE every $ in the bcrypt hash
# ($ -> $$) or compose eats it and Caddy gets a broken hash.
#
# Generate + double in one step:
#   RAW=$(docker run --rm caddy:2-alpine caddy hash-password --plaintext 'YOUR_PASSWORD')
#   echo "STATUS_USER=admin"            >  status.env
#   echo "STATUS_HASH=${RAW//\$/\$\$}"  >> status.env
#
# The stored value will look like $$2a$$14$$... — that is correct; compose collapses
# it back to $2a$14$... inside the container. Verify with:
#   docker compose exec caddy printenv STATUS_HASH   # should show single $2a$14$...
STATUS_USER=admin
STATUS_HASH=$$2a$$14$$replace_with_doubled_bcrypt_hash
